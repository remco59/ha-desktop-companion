<Window
    x:Class="DesktopCompanion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Desktop Companion">
    <Grid Background="#0E1020">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121528" Padding="18,22">
            <StackPanel Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#8755E8">
                        <FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Desktop Companion" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="HOME ASSISTANT FOR WINDOWS" FontSize="9" CharacterSpacing="80" Foreground="#969BB7" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="5">
                    <Button Tag="Overview" Content="  Overview" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="#30254E" Foreground="White"
                            BorderThickness="0" Padding="12,10" CornerRadius="8" />
                    <Button Tag="Home Assistant" Content="  Home Assistant" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Button Tag="Sensors" Content="  Sensors" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Button Tag="Actions" Content="  Actions" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Button Tag="Dashboards" Content="  Dashboards" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Button Tag="Applications &amp; Media" Content="  Applications &amp; Media" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Button Tag="Notifications" Content="  Notifications" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Spacing="5">
                    <Button Tag="Settings" Content="  Settings" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C4C7D8"
                            BorderThickness="0" Padding="12,10" />
                    <Border Background="#1D223A" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="HOME ASSISTANT" FontSize="10" CharacterSpacing="90" Foreground="#A8ADC6" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="#E0A94D" />
                                <TextBlock Text="Not connected" Foreground="#D8D9E4" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,28,32,36" Spacing="22">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="PageTitle" Text="Overview" FontSize="29" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="PageSubtitle" Text="Your PC and Home Assistant, in one place."
                               FontSize="13" Foreground="#A5AAC4" />
                </StackPanel>

                <StackPanel x:Name="OverviewContent" Spacing="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1A1E34" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="WORKSTATION" FontSize="10" CharacterSpacing="100" Foreground="#A5AAC4" />
                                <TextBlock Text="Windows device running" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Tray companion is active in the background." FontSize="12" Foreground="#A5AAC4" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1A1E34" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="HOME ASSISTANT" FontSize="10" CharacterSpacing="100" Foreground="#A5AAC4" />
                                <TextBlock x:Name="OverviewConnectionTitle" Text="Not connected" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock x:Name="OverviewConnectionDetail" Text="Connect an instance to discover your entities." FontSize="12" Foreground="#A5AAC4" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1A1E34" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="CPU" Foreground="#A5AAC4" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#8D92AD" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1A1E34" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="MEMORY" Foreground="#A5AAC4" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#8D92AD" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1A1E34" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="GPU" Foreground="#A5AAC4" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#8D92AD" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#1A1E34" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="UPTIME" Foreground="#A5AAC4" FontSize="12" />
                                <TextBlock x:Name="UptimeValue" Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Since last boot" Foreground="#8D92AD" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1A1E34" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Your favourite Windows and Home Assistant actions will appear here."
                                           Foreground="#A5AAC4" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="Action editor is planned for a later milestone."
                                           Foreground="#8D92AD" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1A1E34" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Getting started" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="1. Connect Home Assistant" Foreground="#D4D6E3" FontSize="12" />
                                <TextBlock Text="2. Discover Windows sensors" Foreground="#D4D6E3" FontSize="12" />
                                <TextBlock Text="3. Personalise your dashboard" Foreground="#D4D6E3" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>


                <Border x:Name="HomeAssistantContent" Background="#1A1E34" CornerRadius="14" Padding="24"
                        Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="720">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Connect your Home Assistant instance" FontSize="20"
                                       FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Use the same URL you normally open in your browser. Sign-in happens securely on the Home Assistant website."
                                       FontSize="12" Foreground="#A5AAC4" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="INSTANCE URL" FontSize="10" CharacterSpacing="90" Foreground="#A5AAC4" />
                            <TextBox x:Name="HomeAssistantUrlInput"
                                     PlaceholderText="http://homeassistant.local:8123"
                                     Background="#11162A" Foreground="White"
                                     BorderBrush="#39415F" CornerRadius="8" Padding="12,9" />
                            <TextBlock Text="Include http:// or https:// and any reverse-proxy path prefix."
                                       FontSize="11" Foreground="#8D92AD" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ConnectHomeAssistantButton" Content="Connect Home Assistant"
                                    Click="OnConnectHomeAssistantClicked"
                                    Background="#8755E8" Foreground="White" BorderThickness="0"
                                    CornerRadius="8" Padding="16,10" />
                            <Button x:Name="DisconnectHomeAssistantButton" Content="Disconnect"
                                    Click="OnDisconnectHomeAssistantClicked"
                                    Background="#282E48" Foreground="#D8DBEA" BorderThickness="0"
                                    CornerRadius="8" Padding="16,10" IsEnabled="False" />
                        </StackPanel>
                        <Border Background="#11162A" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="#E0A94D"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConnectionStatusTitle" Text="Not connected"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="ConnectionStatusDetail"
                                           Text="Enter your Home Assistant URL to get started."
                                           Foreground="#A5AAC4" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Your refresh token is stored in Windows Credential Manager. Desktop Companion does not store your Home Assistant password."
                                   FontSize="11" Foreground="#8D92AD" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="PlaceholderContent" Background="#1A1E34" CornerRadius="14" Padding="24"
                        Visibility="Collapsed">
                    <StackPanel Spacing="9">
                        <TextBlock x:Name="PlaceholderTitle" Text="Coming soon" FontSize="19"
                                   FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="PlaceholderDescription" Text="This area is part of the project roadmap."
                                   FontSize="13" Foreground="#A5AAC4" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
