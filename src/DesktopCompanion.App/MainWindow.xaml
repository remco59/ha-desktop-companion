<Window
    x:Class="DesktopCompanion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Desktop Companion">
    <Grid Background="#111318">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#171A1F" Padding="18,22">
            <StackPanel Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#03A9F4">
                        <FontIcon Glyph="&#xE8D4;" FontSize="20" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Desktop Companion" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="HOME ASSISTANT FOR WINDOWS" FontSize="9" CharacterSpacing="80" Foreground="#A7ADB7" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="5">
                    <Button x:Name="OverviewNavigationButton" Tag="Overview" Content="  Overview" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="#123B4B" Foreground="White"
                            BorderThickness="0" Padding="12,10" CornerRadius="8" />
                    <Button x:Name="HomeAssistantNavigationButton" Tag="Home Assistant" Content="  Home Assistant" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Button x:Name="SensorsNavigationButton" Tag="Sensors" Content="  Sensors" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Button x:Name="ActionsNavigationButton" Tag="Actions" Content="  Actions" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Button x:Name="DashboardNavigationButton" Tag="Dashboard" Content="  Dashboard" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Button x:Name="ApplicationsNavigationButton" Tag="Applications &amp; Media" Content="  Applications &amp; Media" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Button x:Name="NotificationsNavigationButton" Tag="Notifications" Content="  Notifications" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Spacing="5">
                    <Button x:Name="SettingsNavigationButton" Tag="Settings" Content="  Settings" Click="OnNavigationClicked"
                            HorizontalContentAlignment="Left" Background="Transparent" Foreground="#DFE3E8"
                            BorderThickness="0" Padding="12,10" />
                    <Border Background="#20242B" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="HOME ASSISTANT" FontSize="10" CharacterSpacing="90" Foreground="#A8ADC6" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="SidebarConnectionDot" Width="8" Height="8" Fill="#E0A94D" />
                                <TextBlock x:Name="SidebarConnectionText" Text="Not connected" Foreground="#DFE3E8" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#111318">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Padding="32,24,32,16" Spacing="5">
                <TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="PageSubtitle" Text="Your PC and Home Assistant, in one place."
                           FontSize="13" Foreground="#A7ADB7" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="32,0,32,28">
                <ScrollViewer x:Name="ScrollablePageContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22">
                        <StackPanel x:Name="OverviewContent" Spacing="16">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1C1F26" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="WORKSTATION" FontSize="10" CharacterSpacing="100" Foreground="#A7ADB7" />
                                <TextBlock Text="Windows device running" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Tray companion is active in the background." FontSize="12" Foreground="#A7ADB7" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1C1F26" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="HOME ASSISTANT" FontSize="10" CharacterSpacing="100" Foreground="#A7ADB7" />
                                <TextBlock x:Name="OverviewConnectionTitle" Text="Not connected" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock x:Name="OverviewConnectionDetail" Text="Connect an instance to discover your entities." FontSize="12" Foreground="#A7ADB7" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1C1F26" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="CPU" Foreground="#A7ADB7" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#818A97" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1C1F26" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="MEMORY" Foreground="#A7ADB7" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#818A97" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1C1F26" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="GPU" Foreground="#A7ADB7" FontSize="12" />
                                <TextBlock Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Sensor provider next" Foreground="#818A97" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#1C1F26" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="7">
                                <TextBlock Text="UPTIME" Foreground="#A7ADB7" FontSize="12" />
                                <TextBlock x:Name="UptimeValue" Text="—" Foreground="White" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="Since last boot" Foreground="#818A97" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1C1F26" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Your favourite Windows and Home Assistant actions will appear here."
                                           Foreground="#A7ADB7" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="Action editor is planned for a later milestone."
                                           Foreground="#818A97" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1C1F26" CornerRadius="12" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Getting started" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="1. Connect Home Assistant" Foreground="#DFE3E8" FontSize="12" />
                                <TextBlock Text="2. Discover Windows sensors" Foreground="#DFE3E8" FontSize="12" />
                                <TextBlock Text="3. Personalise your dashboard" Foreground="#DFE3E8" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>


                <Border x:Name="HomeAssistantContent" Background="#1C1F26" CornerRadius="14" Padding="24"
                        Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="720">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Home Assistant connection" FontSize="20"
                                       FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Connect Desktop Companion to your Home Assistant instance. The dashboard itself is rendered by Home Assistant, not recreated by this app."
                                       FontSize="12" Foreground="#A7ADB7" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="INSTANCE URL" FontSize="10" CharacterSpacing="90" Foreground="#A7ADB7" />
                            <TextBox x:Name="HomeAssistantUrlInput"
                                     PlaceholderText="https://homeassistant.local:8123"
                                     Background="#171A1F" Foreground="White"
                                     BorderBrush="#343A44" CornerRadius="8" Padding="12,9" />
                            <TextBlock Text="Use the same URL you normally open in your browser, including any reverse-proxy path."
                                       FontSize="11" Foreground="#818A97" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ConnectHomeAssistantButton" Content="Connect Home Assistant"
                                    Click="OnConnectHomeAssistantClicked"
                                    Background="#03A9F4" Foreground="#07131A" BorderThickness="0"
                                    CornerRadius="8" Padding="16,10" />
                            <Button x:Name="DisconnectHomeAssistantButton" Content="Disconnect"
                                    Click="OnDisconnectHomeAssistantClicked"
                                    Background="#2A3038" Foreground="#DFE3E8" BorderThickness="0"
                                    CornerRadius="8" Padding="16,10" IsEnabled="False" />
                        </StackPanel>
                        <Border Background="#171A1F" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8" Fill="#E0A94D"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConnectionStatusTitle" Text="Not connected"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="ConnectionStatusDetail"
                                           Text="Enter your Home Assistant URL to get started."
                                           Foreground="#A7ADB7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="#171A1F" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Dashboard sign-in" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="The native connection uses Home Assistant OAuth for API and live-state access. The embedded dashboard keeps its own secure browser session in your Windows user profile. The first time you open it, Home Assistant may ask you to sign in once more."
                                           FontSize="12" Foreground="#A7ADB7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="PlaceholderContent" Background="#1C1F26" CornerRadius="14" Padding="24"
                        Visibility="Collapsed">
                    <StackPanel Spacing="9">
                        <TextBlock x:Name="PlaceholderTitle" Text="Coming soon" FontSize="19"
                                   FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="PlaceholderDescription" Text="This area is part of the project roadmap."
                                   FontSize="13" Foreground="#A7ADB7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DashboardContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Home Assistant dashboard" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="DashboardStatusText" Text="Ready to load your dashboard"
                                       FontSize="11" Foreground="#A7ADB7" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Click="OnRefreshDashboardClicked"
                                Background="#2A3038" Foreground="#DFE3E8" BorderThickness="0"
                                CornerRadius="8" Padding="13,8" />
                        <Button Grid.Column="2" Content="Open in browser" Click="OnOpenDashboardInBrowserClicked"
                                Background="#2A3038" Foreground="#DFE3E8" BorderThickness="0"
                                CornerRadius="8" Padding="13,8" />
                    </Grid>
                    <Border Grid.Row="1" Background="#171A1F" BorderBrush="#343A44"
                            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <WebView2 x:Name="HomeAssistantWebView"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      DefaultBackgroundColor="#111318" />
                            <Border x:Name="DashboardUnavailableOverlay" Background="#171A1F"
                                    CornerRadius="12" Padding="24" Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="420" Spacing="10">
                                    <FontIcon Glyph="&#xE80F;" FontSize="30" Foreground="#03A9F4"
                                              HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DashboardUnavailableTitle" Text="Connect Home Assistant"
                                               FontSize="18" FontWeight="SemiBold" Foreground="White"
                                               HorizontalTextAlignment="Center" />
                                    <TextBlock x:Name="DashboardUnavailableDetail"
                                               Text="Add your Home Assistant instance first. Its native dashboard will appear here."
                                               FontSize="12" Foreground="#A7ADB7" TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <Button Content="Open connection settings" Click="OnOpenConnectionSettingsClicked"
                                            Background="#03A9F4" Foreground="#07131A" BorderThickness="0"
                                            CornerRadius="8" Padding="14,9" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
