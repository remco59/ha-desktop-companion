<Window
    x:Class="DesktopCompanion.App.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Desktop Companion">
    <Grid x:Name="RootGrid" Background="#111318" KeyDown="OnRootKeyDown">
        <Border Background="#1C1F26"
                BorderBrush="#343A44"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#03A9F4">
                            <FontIcon Glyph="&#xE8D4;" FontSize="18" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Desktop Companion" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="WINDOWS COMPANION FOR HOME ASSISTANT" FontSize="9" CharacterSpacing="100" Foreground="#A7ADB7" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="&#xE713;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="9"
                            Background="#2A3038"
                            Foreground="#DFE3E8"
                            BorderThickness="0"
                            Click="OnSettingsClicked"
                            ToolTipService.ToolTip="Open settings" />
                </Grid>

                <Border Background="#20242B" CornerRadius="11" Padding="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="#2B3942">
                            <FontIcon Glyph="&#xE9F5;" FontSize="17" Foreground="#81D4FA"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="This computer" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="ComputerNameText" Text="Windows PC" Foreground="#A7ADB7" FontSize="10" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="#173E3B" CornerRadius="8" Padding="8,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="#62D6AE" />
                                <TextBlock Text="Running" Foreground="#91E7C9" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#20242B" CornerRadius="11" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="SYSTEM UPTIME" FontSize="9" CharacterSpacing="90" Foreground="#A7ADB7" />
                            <TextBlock x:Name="UptimeText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Since last boot" FontSize="10" Foreground="#818A97" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#20242B" CornerRadius="11" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="HOME ASSISTANT" FontSize="9" CharacterSpacing="80" Foreground="#A7ADB7" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="HomeAssistantStatusDot" Width="7" Height="7" Fill="#E1A64C" />
                                <TextBlock x:Name="HomeAssistantStatusText" Text="Not connected" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                            <TextBlock x:Name="HomeAssistantStatusDetail" Text="Connect in the app" FontSize="10" Foreground="#818A97" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="QUICK ACCESS" FontSize="10" CharacterSpacing="100" Foreground="#A7ADB7" />
                    <Button x:Name="OpenDashboardButton"
                            HorizontalContentAlignment="Left"
                            Background="#123B4B"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="9"
                            Padding="12,10"
                            Click="OnOpenDashboardClicked">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                                <TextBlock Text="Open Home Assistant dashboard" FontSize="12" FontWeight="SemiBold" />
                                <FontIcon Glyph="&#xE76C;" FontSize="11" Margin="20,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <TextBlock Text="Volume, sensor and Home Assistant controls will appear here as they are connected."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#A7ADB7" />
                </StackPanel>

                <Border Height="1" Background="#343A44" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Desktop Companion · Early access" FontSize="10" Foreground="#7F86A4"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Exit"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#C7CBE0"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="OnExitClicked" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
